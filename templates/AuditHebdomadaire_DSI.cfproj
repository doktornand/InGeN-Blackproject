    "functions": [
      {
        "id": "fn_205",
        "type": "function",
        "name": "Get-StaleADAccounts",
        "language": "PowerShell",
        "famille": "ActiveDirectory",
        "description": "Identifie les comptes AD inactifs depuis > N jours",
        "parameters": [
          { "name": "InactiveDays", "datatype": "int", "required": false, "default": "90" },
          { "name": "SearchBase", "datatype": "string", "required": false, "default": "$DefaultOUUsers" }
        ],
        "returns": { "datatype": "PSObject[]", "description": "Comptes inactifs" },
        "tags": ["ad", "audit", "security", "cleanup"]
      },
      {
        "id": "fn_601",
        "type": "function",
        "name": "Get-DiskHealth",
        "language": "PowerShell",
        "famille": "Inventory",
        "description": "Vérifie l'espace disponible sur les volumes avec seuil d'alerte",
        "parameters": [
          { "name": "ComputerName", "datatype": "string", "required": false, "default": "$env:COMPUTERNAME" },
          { "name": "ThresholdPct", "datatype": "int", "required": false, "default": "15" }
        ],
        "returns": { "datatype": "PSObject[]", "description": "État des volumes" },
        "tags": ["disk", "health", "monitoring"]
      },
      {
        "id": "fn_701",
        "type": "function",
        "name": "Get-ServiceHealth",
        "language": "PowerShell",
        "famille": "Services",
        "description": "Vérifie l'état des services critiques",
        "parameters": [
          { "name": "CriticalServices", "datatype": "string[]", "required": true },
          { "name": "ComputerName", "datatype": "string", "required": false, "default": "$env:COMPUTERNAME" },
          { "name": "AlertEmail", "datatype": "string", "required": false, "default": "\"\"" }
        ],
        "returns": { "datatype": "PSObject[]", "description": "État services" },
        "tags": ["services", "monitoring"]
      },
      {
        "id": "fn_800",
        "type": "function",
        "name": "Get-SecurityEvents",
        "language": "PowerShell",
        "famille": "Security",
        "description": "Collecte les événements sécurité de la semaine",
        "parameters": [
          { "name": "ComputerName", "datatype": "string", "required": false, "default": "$DomainController" },
          { "name": "EventIDs", "datatype": "int[]", "required": false, "default": "$CriticalEventIDs" },
          { "name": "HoursBack", "datatype": "int", "required": false, "default": "168" }
        ],
        "returns": { "datatype": "PSObject[]", "description": "Événements collectés" },
        "tags": ["security", "eventlog", "audit"]
      },
      {
        "id": "fn_1300",
        "type": "function",
        "name": "Export-AuditReport",
        "language": "PowerShell",
        "famille": "Reporting",
        "description": "Exporte le rapport hebdo consolidé en HTML",
        "parameters": [
          { "name": "Data", "datatype": "PSObject[]", "required": true },
          { "name": "Title", "datatype": "string", "required": true },
          { "name": "OutputDir", "datatype": "string", "required": false, "default": "\"C:\\\\Reports\"" },
          { "name": "Format", "datatype": "string[]", "required": false, "default": "@('HTML')" }
        ],
        "returns": { "datatype": "string[]", "description": "Fichiers générés" },
        "tags": ["reporting", "export", "html"]
      },
      {
        "id": "fn_101",
        "type": "function",
        "name": "Send-AlertMail",
        "language": "PowerShell",
        "famille": "Logging",
        "description": "Envoie le rapport hebdo à la direction DSI",
        "parameters": [
          { "name": "To", "datatype": "string", "required": true },
          { "name": "Subject", "datatype": "string", "required": true },
          { "name": "Body", "datatype": "string", "required": true }
        ],
        "returns": { "datatype": "bool", "description": "Succès envoi" },
        "tags": ["mail", "alert"]
      }
    ],
    "variables": [
      {
        "id": "var_012",
        "type": "variable",
        "name": "DefaultOUUsers",
        "language": "PowerShell",
        "famille": "ActiveDirectory",
        "datatype": "string",
        "default_value": "\"OU=Utilisateurs,DC=corp,DC=local\"",
        "description": "OU utilisateurs",
        "scope": "global",
        "tags": ["ad", "ou"]
      },
      {
        "id": "var_020",
        "type": "variable",
        "name": "CriticalEventIDs",
