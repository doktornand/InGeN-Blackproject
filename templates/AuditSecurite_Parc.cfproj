    "functions": [
      {
        "id": "fn_900",
        "type": "function",
        "name": "Get-ADComputersList",
        "language": "PowerShell",
        "famille": "ActiveDirectory",
        "description": "Retourne la liste des ordinateurs AD d'une OU",
        "parameters": [
          { "name": "SearchBase", "datatype": "string", "required": false, "default": "$DefaultOUComputers" },
          { "name": "PingCheck", "datatype": "switch", "required": false, "default": "false" },
          { "name": "OSFilter", "datatype": "string", "required": false, "default": "\"*\"" }
        ],
        "returns": { "datatype": "PSObject[]", "description": "Liste des ordinateurs" },
        "tags": ["ad", "computers", "inventory"]
      },
      {
        "id": "fn_802",
        "type": "function",
        "name": "Invoke-SecurityBaseline",
        "language": "PowerShell",
        "famille": "Security",
        "description": "Vérifie la conformité sécurité DSI d'un poste",
        "parameters": [
          { "name": "ComputerName", "datatype": "string", "required": false, "default": "$env:COMPUTERNAME" }
        ],
        "returns": { "datatype": "PSObject", "description": "Rapport conformité" },
        "tags": ["security", "baseline", "compliance"]
      },
      {
        "id": "fn_1101",
        "type": "function",
        "name": "Get-LocalAdmins",
        "language": "PowerShell",
        "famille": "LocalAccounts",
        "description": "Audite les membres du groupe Administrateurs local sur une liste de postes",
        "parameters": [
          { "name": "ComputerNames", "datatype": "string[]", "required": true }
        ],
        "returns": { "datatype": "PSObject[]", "description": "Admins locaux par poste" },
        "tags": ["audit", "local", "admin", "security"]
      },
      {
        "id": "fn_502",
        "type": "function",
        "name": "Get-OpenPorts",
        "language": "PowerShell",
        "famille": "Network",
        "description": "Liste les ports TCP/UDP en écoute avec processus",
        "parameters": [
          { "name": "ComputerName", "datatype": "string", "required": false, "default": "$env:COMPUTERNAME" },
          { "name": "Protocol", "datatype": "string", "required": false, "default": "\"TCP\"" }
        ],
        "returns": { "datatype": "PSObject[]", "description": "Ports ouverts" },
        "tags": ["network", "security", "ports"]
      },
      {
        "id": "fn_1300",
        "type": "function",
        "name": "Export-AuditReport",
        "language": "PowerShell",
        "famille": "Reporting",
        "description": "Exporte un rapport d'audit DSI en CSV/HTML",
        "parameters": [
          { "name": "Data", "datatype": "PSObject[]", "required": true },
          { "name": "Title", "datatype": "string", "required": true },
          { "name": "OutputDir", "datatype": "string", "required": false, "default": "\"C:\\\\Reports\"" },
          { "name": "Format", "datatype": "string[]", "required": false, "default": "@('CSV','HTML')" }
        ],
        "returns": { "datatype": "string[]", "description": "Fichiers générés" },
        "tags": ["reporting", "export"]
      }
    ],
    "variables": [
      {
        "id": "var_013",
        "type": "variable",
        "name": "DefaultOUComputers",
        "language": "PowerShell",
        "famille": "ActiveDirectory",
        "datatype": "string",
        "default_value": "\"OU=Postes,DC=corp,DC=local\"",
        "description": "OU postes",
        "scope": "global",
        "tags": ["ad", "ou", "computers"]
      }
    ]
