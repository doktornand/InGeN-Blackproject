      {
        "id": "fn_801",
        "type": "function",
        "name": "Get-LockedADAccounts",
        "language": "PowerShell",
        "famille": "Security",
        "description": "Liste les comptes AD verrouillés avec origine du verrouillage",
        "parameters": [
          { "name": "SearchBase", "datatype": "string", "required": false, "default": "$DefaultOUUsers" }
        ],
        "returns": { "datatype": "PSObject[]", "description": "Comptes verrouillés" },
        "tags": ["security", "ad", "lockout"]
      },
      {
        "id": "fn_800",
        "type": "function",
        "name": "Get-SecurityEvents",
        "language": "PowerShell",
        "famille": "Security",
        "description": "Extrait les événements de sécurité Windows (4625/4740)",
        "parameters": [
          { "name": "ComputerName", "datatype": "string", "required": false, "default": "$DomainController" },
          { "name": "EventIDs", "datatype": "int[]", "required": false, "default": "$CriticalEventIDs" },
          { "name": "HoursBack", "datatype": "int", "required": false, "default": "24" }
        ],
        "returns": { "datatype": "PSObject[]", "description": "Événements collectés" },
        "tags": ["security", "eventlog", "audit"]
      },
      {
        "id": "fn_202",
        "type": "function",
        "name": "Reset-ADUserPassword",
        "language": "PowerShell",
        "famille": "ActiveDirectory",
        "description": "Réinitialise le MDP AD avec forçage changement",
        "parameters": [
          { "name": "SamAccountName", "datatype": "string", "required": true },
          { "name": "NewPassword", "datatype": "string", "required": true }
        ],
        "returns": { "datatype": "void", "description": "" },
        "tags": ["ad", "password", "security"]
      },
      {
        "id": "fn_101",
        "type": "function",
        "name": "Send-AlertMail",
        "language": "PowerShell",
        "famille": "Logging",
        "description": "Notifie le manager et la DSI",
        "parameters": [
          { "name": "To", "datatype": "string", "required": true },
          { "name": "Subject", "datatype": "string", "required": true },
          { "name": "Body", "datatype": "string", "required": true }
        ],
        "returns": { "datatype": "bool", "description": "Succès envoi" },
        "tags": ["mail", "alert"]
      },
      {
        "id": "fn_100",
        "type": "function",
        "name": "Write-SysLog",
        "language": "PowerShell",
        "famille": "Logging",
        "description": "Journalise l'incident lockout",
        "parameters": [
          { "name": "Message", "datatype": "string", "required": true },
          { "name": "Level", "datatype": "string", "required": false, "default": "WARN" }
        ],
        "returns": { "datatype": "void", "description": "" },
        "tags": ["logging"]
      }
