    "functions": [
      {
        "id": "fn_200",
        "type": "function",
        "name": "New-ADUserDSI",
        "language": "PowerShell",
        "famille": "ActiveDirectory",
        "description": "Crée un compte utilisateur AD avec conventions DSI",
        "parameters": [
          { "name": "GivenName", "datatype": "string", "required": true },
          { "name": "Surname", "datatype": "string", "required": true },
          { "name": "Department", "datatype": "string", "required": true },
          { "name": "OU", "datatype": "string", "required": false, "default": "$DefaultOUUsers" },
          { "name": "BaseGroups", "datatype": "string[]", "required": false, "default": "@('GRP_Utilisateurs')" },
          { "name": "TempPassword", "datatype": "string", "required": false, "default": "\"P@ss_Temp2025!\"" }
        ],
        "returns": { "datatype": "ADUser", "description": "Objet ADUser créé" },
        "tags": ["ad", "users", "create"]
      },
      {
        "id": "fn_101",
        "type": "function",
        "name": "Send-AlertMail",
        "language": "PowerShell",
        "famille": "Logging",
        "description": "Envoie un email d'alerte via SMTP interne DSI",
        "parameters": [
          { "name": "To", "datatype": "string", "required": true },
          { "name": "Subject", "datatype": "string", "required": true },
          { "name": "Body", "datatype": "string", "required": true },
          { "name": "From", "datatype": "string", "required": false, "default": "noreply@corp.local" }
        ],
        "returns": { "datatype": "bool", "description": "Succès envoi" },
        "tags": ["mail", "alert"]
      },
      {
        "id": "fn_100",
        "type": "function",
        "name": "Write-SysLog",
        "language": "PowerShell",
        "famille": "Logging",
        "description": "Journalise un message horodaté",
        "parameters": [
          { "name": "Message", "datatype": "string", "required": true },
          { "name": "Level", "datatype": "string", "required": false, "default": "INFO" },
          { "name": "LogFile", "datatype": "string", "required": false, "default": "$LogFilePath" }
        ],
        "returns": { "datatype": "void", "description": "" },
        "tags": ["logging"]
      }
    ],
    "variables": [
      {
        "id": "var_010",
        "type": "variable",
        "name": "DomainFQDN",
        "language": "PowerShell",
        "famille": "ActiveDirectory",
        "datatype": "string",
        "default_value": "\"corp.local\"",
        "description": "Nom de domaine FQDN",
        "scope": "global",
