      },
      {
        "id": "var_012",
        "type": "variable",
        "name": "DefaultOUUsers",
        "language": "PowerShell",
        "famille": "ActiveDirectory",
        "datatype": "string",
        "default_value": "\"OU=Utilisateurs,DC=corp,DC=local\"",
        "description": "OU par défaut utilisateurs",
        "scope": "global",
        "tags": ["ad", "ou"]
      },
      {
        "id": "var_015",
        "type": "variable",
        "name": "SMTPServer",
        "language": "PowerShell",
