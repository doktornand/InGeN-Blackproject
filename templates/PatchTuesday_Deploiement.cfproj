    "functions": [
      {
        "id": "fn_401",
        "type": "function",
        "name": "Get-PendingUpdates",
        "language": "PowerShell",
        "famille": "Updates",
        "description": "Liste les MAJ Windows en attente sur un ou plusieurs postes",
        "parameters": [
          { "name": "ComputerNames", "datatype": "string[]", "required": false, "default": "@($env:COMPUTERNAME)" }
        ],
        "returns": { "datatype": "PSObject[]", "description": "MAJ en attente par machine" },
        "tags": ["updates", "audit", "wsus"]
      },
      {
        "id": "fn_400",
        "type": "function",
        "name": "Install-WindowsUpdates",
        "language": "PowerShell",
        "famille": "Updates",
        "description": "Lance l'installation des MAJ Windows disponibles via WSUS",
        "parameters": [
          { "name": "AcceptAll", "datatype": "switch", "required": false, "default": "false" },
          { "name": "AutoReboot", "datatype": "switch", "required": false, "default": "false" },
          { "name": "ExcludeKBs", "datatype": "string[]", "required": false, "default": "@()" }
        ],
        "returns": { "datatype": "PSObject[]", "description": "MAJ installées" },
        "tags": ["updates", "wsus", "windows"]
      },
      {
        "id": "fn_701",
        "type": "function",
        "name": "Get-ServiceHealth",
        "language": "PowerShell",
        "famille": "Services",
        "description": "Vérifie l'état des services critiques post-MAJ",
        "parameters": [
          { "name": "CriticalServices", "datatype": "string[]", "required": true },
          { "name": "ComputerName", "datatype": "string", "required": false, "default": "$env:COMPUTERNAME" },
          { "name": "AlertEmail", "datatype": "string", "required": false, "default": "\"\"" }
        ],
        "returns": { "datatype": "PSObject[]", "description": "État des services" },
        "tags": ["services", "monitoring", "alert"]
      },
      {
        "id": "fn_1300",
        "type": "function",
        "name": "Export-AuditReport",
        "language": "PowerShell",
        "famille": "Reporting",
        "description": "Exporte rapport MAJ en CSV/HTML",
        "parameters": [
          { "name": "Data", "datatype": "PSObject[]", "required": true },
          { "name": "Title", "datatype": "string", "required": true },
          { "name": "OutputDir", "datatype": "string", "required": false, "default": "\"C:\\\\Reports\"" },
          { "name": "Format", "datatype": "string[]", "required": false, "default": "@('CSV','HTML')" }
        ],
        "returns": { "datatype": "string[]", "description": "Fichiers générés" },
        "tags": ["reporting", "export"]
      },
      {
        "id": "fn_101",
        "type": "function",
        "name": "Send-AlertMail",
        "language": "PowerShell",
        "famille": "Logging",
        "description": "Envoie le rapport mail DSI",
        "parameters": [
          { "name": "To", "datatype": "string", "required": true },
          { "name": "Subject", "datatype": "string", "required": true },
          { "name": "Body", "datatype": "string", "required": true },
          { "name": "From", "datatype": "string", "required": false, "default": "noreply@corp.local" }
        ],
        "returns": { "datatype": "bool", "description": "Succès envoi" },
        "tags": ["mail", "alert"]
      }
    ],
    "variables": [
      {
        "id": "var_017",
        "type": "variable",
        "name": "WsusServer",
        "language": "PowerShell",
        "famille": "Updates",
        "datatype": "string",
        "default_value": "\"wsus.corp.local\"",
        "description": "Serveur WSUS",
        "scope": "global",
        "tags": ["wsus", "updates"]
      },
      {
