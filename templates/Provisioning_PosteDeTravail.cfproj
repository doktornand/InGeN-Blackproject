    "functions": [
      {
        "id": "fn_901",
        "type": "function",
        "name": "Join-DomainDSI",
        "language": "PowerShell",
        "famille": "ActiveDirectory",
        "description": "Intègre un poste au domaine AD DSI",
        "parameters": [
          { "name": "ComputerName", "datatype": "string", "required": true },
          { "name": "TargetOU", "datatype": "string", "required": false, "default": "$DefaultOUComputers" },
          { "name": "Credential", "datatype": "PSCredential", "required": true }
        ],
        "returns": { "datatype": "void", "description": "" },
        "tags": ["ad", "domain", "computers", "provisioning"]
      },
      {
        "id": "fn_1100",
        "type": "function",
        "name": "New-LocalAdminAccount",
        "language": "PowerShell",
        "famille": "LocalAccounts",
        "description": "Crée un compte admin local DSI sur le poste",
        "parameters": [
          { "name": "ComputerName", "datatype": "string", "required": false, "default": "$env:COMPUTERNAME" },
          { "name": "Username", "datatype": "string", "required": true },
          { "name": "Password", "datatype": "string", "required": true },
          { "name": "DisableDefault", "datatype": "switch", "required": false, "default": "true" }
        ],
        "returns": { "datatype": "void", "description": "" },
        "tags": ["local", "admin", "security", "accounts"]
      },
      {
        "id": "fn_1000",
        "type": "function",
        "name": "Apply-GPODSIBaseline",
        "language": "PowerShell",
        "famille": "GPO",
        "description": "Force le rafraîchissement GPO sur le poste",
        "parameters": [
          { "name": "ComputerNames", "datatype": "string[]", "required": true },
          { "name": "LogonScripts", "datatype": "switch", "required": false, "default": "false" }
        ],
        "returns": { "datatype": "PSObject[]", "description": "Résultats GPO" },
        "tags": ["gpo", "policy"]
      },
      {
        "id": "fn_500",
        "type": "function",
        "name": "Test-NetworkDiag",
        "language": "PowerShell",
        "famille": "Network",
        "description": "Diagnostic réseau complet : ping, DNS, port",
        "parameters": [
          { "name": "Target", "datatype": "string", "required": true },
          { "name": "Port", "datatype": "int", "required": false, "default": "443" },
          { "name": "DnsServer", "datatype": "string", "required": false, "default": "\"\"" }
        ],
        "returns": { "datatype": "PSObject", "description": "Rapport diagnostic" },
        "tags": ["network", "diagnostic", "ping"]
      },
      {
        "id": "fn_600",
        "type": "function",
        "name": "Get-SystemInventory",
        "language": "PowerShell",
        "famille": "Inventory",
        "description": "Collecte l'inventaire matériel et logiciel complet",
        "parameters": [
          { "name": "ComputerName", "datatype": "string", "required": false, "default": "$env:COMPUTERNAME" },
          { "name": "IncludeSoftware", "datatype": "switch", "required": false, "default": "true" }
        ],
        "returns": { "datatype": "PSObject", "description": "Inventaire complet" },
        "tags": ["inventory", "audit", "hardware"]
      },
      {
        "id": "fn_100",
        "type": "function",
        "name": "Write-SysLog",
        "language": "PowerShell",
        "famille": "Logging",
        "description": "Journalise la fin du provisioning",
        "parameters": [
          { "name": "Message", "datatype": "string", "required": true },
          { "name": "Level", "datatype": "string", "required": false, "default": "INFO" }
        ],
        "returns": { "datatype": "void", "description": "" },
        "tags": ["logging"]
      }
    ],
    "variables": [
      {
        "id": "var_010",
        "type": "variable",
        "name": "DomainFQDN",
        "language": "PowerShell",
        "famille": "ActiveDirectory",
